# The test suite is not part of the theme and must never be served.
#
# The deployment does not include this directory at all — tools/package-release.sh
# excludes it and tools/check-release-archive.sh asserts that it is absent —
# so this file is defence in depth for an installation that serves the
# repository directly, as a development installation does.
#
# It is not the primary control. A rule in a file only protects the server
# that reads it: nginx does not read .htaccess at all, and an Apache that
# refuses an override ignores it. The primary control is that the profile
# these tests read now lives outside the repository, in the operator's own
# configuration directory.

# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
